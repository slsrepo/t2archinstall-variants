# Maintainer: Sl (Shahaf Levi) <arch@slsrepo.com>

pkgname=t2artixinstall-git
pkgver=r0.0.v0.0
pkgrel=1
pkgdesc="Multi-init Artix edition of Sl's Arch Linux Installer TUI for Intel Macs with the T2 Security Chip"
arch=('any')
url="https://github.com/slsrepo/t2archinstall-variants"
license=('Apache-2.0')
depends=('python' 'python-textual')
makedepends=('git' 'python')
provides=('t2artixinstall')
conflicts=('t2artixinstall' 't2archinstall' 'sl-archinstall')
source=(
  "installer::git+https://github.com/slsrepo/t2archinstall-variants.git"
  "t2archinstall::git+https://github.com/slsrepo/t2archinstall.git"
)
sha256sums=('SKIP' 'SKIP')

pkgver() {
  local upstream_count upstream_hash variants_count variants_hash

  cd "$srcdir/t2archinstall"
  upstream_count=$(git rev-list --count HEAD)
  upstream_hash=$(git rev-parse --short HEAD)

  cd "$srcdir/installer"
  variants_count=$(git rev-list --count HEAD)
  variants_hash=$(git rev-parse --short HEAD)

  printf "r%s.%s.v%s.%s" \
    "$upstream_count" "$upstream_hash" "$variants_count" "$variants_hash"
}

prepare() {
  cd "$srcdir/installer"
  python3 build-artix-installer.py t2artixinstall --source "$srcdir/t2archinstall/t2archinstall.py"
}

check() {
  python3 -m py_compile "$srcdir/installer/t2artixinstall"
}

package() {
  install -Dm755 "$srcdir/installer/t2artixinstall" "$pkgdir/usr/bin/t2artixinstall"
}
